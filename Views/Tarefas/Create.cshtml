
@model TaskFlowWeb.Models.Tarefa

@{
    ViewData["Title"] = "Nova tarefa";
}

<div class="container mt-4">
    <h1>Nova tarefa</h1>

    <form action="/Tarefas/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="Titulo" class="form-label">
                Título da tarefa
            </label>

            <input type="text"
                   id="Titulo"
                   name="Titulo"
                   class="form-control"
                   placeholder="Ex.: Estudar C#"
                   maxlength="150"
                   value="@Model.Titulo"
                   required />

            <span asp-validation-for="Titulo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Prioridade" class="form-label">
                Prioridade
            </label>

            <select id="Prioridade"
                    name="Prioridade"
                    class="form-select">
                <option value="Baixa"
                    selected="@(Model.Prioridade == TaskFlowWeb.Models.PrioridadeTarefa.Baixa)">
                    Baixa
                </option>

                <option value="Media"
                    selected="@(Model.Prioridade == TaskFlowWeb.Models.PrioridadeTarefa.Media)">
                    Média
                </option>

                <option value="Alta"
                    selected="@(Model.Prioridade == TaskFlowWeb.Models.PrioridadeTarefa.Alta)">
                    Alta
                </option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Cadastrar tarefa
        </button>

        <a href="/Tarefas" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
