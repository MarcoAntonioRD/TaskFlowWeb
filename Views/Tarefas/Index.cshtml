
@model IEnumerable<TaskFlowWeb.Models.Tarefa>

@{
    ViewData["Title"] = "Minhas Tarefas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Minhas Tarefas</h1>
            <p class="text-muted">Organize suas atividades com o TaskFlow.</p>
        </div>

        <a href="/Tarefas/Create" class="btn btn-primary">
            + Nova tarefa
        </a>
    </div>

    <!-- Pesquisa e filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form action="/Tarefas/Index" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="busca" class="form-label">
                            Pesquisar tarefa
                        </label>

                        <input type="text"
                               id="busca"
                               name="busca"
                               class="form-control"
                               placeholder="Digite o título..."
                               value="@ViewBag.Busca" />
                    </div>

                    <div class="col-md-3">
                        <label for="prioridade" class="form-label">
                            Prioridade
                        </label>

                        <select id="prioridade"
                                name="prioridade"
                                class="form-select">
                            <option value="">Todas</option>
                            <option value="Baixa"
                                    selected="@(ViewBag.Prioridade as string == "Baixa")">
                                Baixa
                            </option>
                            <option value="Media"
                                    selected="@(ViewBag.Prioridade as string == "Media")">
                                Média
                            </option>
                            <option value="Alta"
                                    selected="@(ViewBag.Prioridade as string == "Alta")">
                                Alta
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="status" class="form-label">
                            Situação
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">
                            <option value="">Todas</option>
                            <option value="pendente"
                                    selected="@(ViewBag.Status as string == "pendente")">
                                Pendentes
                            </option>
                            <option value="concluida"
                                    selected="@(ViewBag.Status as string == "concluida")">
                                Concluídas
                            </option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Filtrar
                    </button>

                    <a href="/Tarefas" class="btn btn-outline-secondary">
                        Limpar filtros
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma tarefa encontrada com os filtros selecionados.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                @foreach (var tarefa in Model)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-3 gap-3">
                        <div>
                            <h5 class="mb-2 @(tarefa.Concluida ? "text-decoration-line-through text-muted" : "")">
                                @tarefa.Titulo
                            </h5>

                            @switch (tarefa.Prioridade)
                            {
                                case TaskFlowWeb.Models.PrioridadeTarefa.Baixa:
                                    <span class="badge bg-info text-dark">Prioridade baixa</span>
                                    break;

                                case TaskFlowWeb.Models.PrioridadeTarefa.Media:
                                    <span class="badge bg-warning text-dark">Prioridade média</span>
                                    break;

                                case TaskFlowWeb.Models.PrioridadeTarefa.Alta:
                                    <span class="badge bg-danger">Prioridade alta</span>
                                    break;

                                default:
                                    <span class="badge bg-warning text-dark">Prioridade média</span>
                                    break;
                            }

                            @if (tarefa.Concluida)
                            {
                                <span class="badge bg-success">Concluída</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pendente</span>
                            }
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <form action="/Tarefas/AlternarConclusao" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@tarefa.Id" />

                                @if (tarefa.Concluida)
                                {
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        Reabrir
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Concluir
                                    </button>
                                }
                            </form>

                            <a href="/Tarefas/Editar?id=@tarefa.Id"
                               class="btn btn-primary btn-sm">
                                Editar
                            </a>

                            <form action="/Tarefas/Excluir" method="post"
                                  onsubmit="return confirm('Tem certeza que deseja excluir esta tarefa?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@tarefa.Id" />

                                <button type="submit" class="btn btn-danger btn-sm">
                                    Excluir
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
